# Supabase (client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL. Production is https://inside.saysukii.com
APP_URL=http://localhost:8080

# Encrypts OAuth credentials stored in Supabase. Use a long random secret (openssl rand -base64 48).
# To rotate it: set the new key here and the old one in _PREVIOUS, redeploy, re-save the stored
# secrets (rekeyStoredSecrets in src/lib/os/rekey.server.ts), then remove _PREVIOUS.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=

# Every email goes out through the Gmail account connected in Settings. Resend is an optional
# backup, used only when gmail can't send; leave both blank to go without it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Say Sukii <studio@saysukii.com>
# Where the studio's own notices go: a new inquiry, a booking, a change request, an approval.
INQUIRY_NOTIFICATION_EMAIL=

# Gmail CRM (inquiry threads — send/receive as Sukii)
# OAuth uses the same Google Cloud app as Calendar. Enable these scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/userinfo.email
# Tokens are encrypted server-side (INTEGRATION_ENCRYPTION_KEY) and never sent to the browser.
GMAIL_INBOX=info@saysukii.com
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/callback

# Every 5 minutes, Supabase (the studio_cron migration) calls each of these (Authorization: Bearer $CRON_SECRET):
#   /api/cron/scheduled-letters  sends letters whose scheduled time has come
#   /api/cron/gmail-inbound      captures new gmail, then classifies and routes it
# Isolated route-only: /api/cron/gmail-route. Pub/Sub push can replace this poller later.
CRON_SECRET=

# Anthropic (server-only — classify inbound mail + engagement summaries. Never expose to the client.)
# Prompt lives in src/lib/os/inquiry-routing.prompt.ts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Square
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_LOCATION_ID=
SQUARE_REDIRECT_URI=http://localhost:8080/api/integrations/square/callback
SQUARE_PAYMENT_REDIRECT_URL=http://localhost:8080
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:8080/api/square/webhook

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary

# Google Maps / Places (inquiry venue picker)
# Enable Places API (New). Calendar OAuth is separate — this is an API key.
GOOGLE_MAPS_API_KEY=
