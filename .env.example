# Supabase (client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL
APP_URL=http://localhost:8080

# Encrypts OAuth credentials stored in Supabase. Use a long random secret.
INTEGRATION_ENCRYPTION_KEY=

# Transactional email (Resend — proposals, deposits)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Say Sukii <studio@saysukii.com>
INQUIRY_NOTIFICATION_EMAIL=

# Gmail CRM (inquiry threads — send/receive as Sukii)
# OAuth uses the same Google Cloud app as Calendar. Enable these scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/userinfo.email
# Tokens are encrypted server-side (INTEGRATION_ENCRYPTION_KEY) and never sent to the browser.
GMAIL_INBOX=info@saysukii.com
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8080/api/integrations/gmail/callback

# Inbound Gmail poll (V1). Lovable cron every 5 minutes:
# GET/POST /api/cron/gmail-inbound  Authorization: Bearer $LOVABLE_CRON_SECRET
# Capture then classify+route. Isolated route-only: /api/cron/gmail-route
# Pub/Sub push can replace this poller later.
LOVABLE_CRON_SECRET=

# Anthropic (server-only — classify inbound mail + engagement summaries. Never expose to the client.)
# Prompt lives in src/lib/os/inquiry-routing.prompt.ts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Square
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_LOCATION_ID=
SQUARE_REDIRECT_URI=http://localhost:8080/api/integrations/square/callback
SQUARE_PAYMENT_REDIRECT_URL=http://localhost:8080
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:8080/api/square/webhook

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GOOGLE_CALENDAR_ID=primary

# Google Maps / Places (inquiry venue picker)
# Enable Places API (New). Calendar OAuth is separate — this is an API key.
GOOGLE_MAPS_API_KEY=
